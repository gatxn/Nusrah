// Nusrah data model.
// NOTE: tier/status/gender/etc. are plain Strings rather than native Postgres
// enums, validated with zod / lib/tiers.ts at the app layer instead — kept
// this way (originally built against SQLite, which has no enum support) for
// simplicity; revisit if stricter DB-level constraints are ever needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  otpVerified  Boolean  @default(false)
  createdAt    DateTime @default(now())
  termsAcceptedAt DateTime @default(now())

  profile          Profile?
  orders           Order[]
  subscription     Subscription?
  otpCodes         OtpCode[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  reviews          Review[]
  contactMessages  ContactMessage[]

  favoritesGiven         Favorite[]     @relation("FavoritesGiven")
  favoritesReceived      Favorite[]     @relation("FavoritesReceived")
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsSourced   Notification[] @relation("NotificationSource")

  blocksGiven      Block[]  @relation("BlocksGiven")
  blocksReceived   Block[]  @relation("BlocksReceived")
  reportsFiled     Report[] @relation("ReportsFiled")
  reportsReceived  Report[] @relation("ReportsReceived")
}

// gender: "MALE" | "FEMALE"
model Profile {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender   String?
  dob      DateTime?
  city     String?
  bio      String?

  // Step 1 (Taarifa Binafsi) additions
  displayName   String?
  maritalStatus String? // SIJAOA_SIJAOLEWA | TALAKA | MJANE | AMETENGANA

  // Step 2 (Maelezo ya Dini) — all new
  religion     String?
  madhhab      String?
  prayerHabit  String?
  wearsHijab   String? // only asked/shown when gender = FEMALE
  quranLevel   String?
  substanceUse String?

  // Step 3 (Maelezo ya Maisha) additions — intentions/bio already existed above
  occupation     String?
  educationLevel String?
  height         Int? // cm
  bodyType       String?
  skinTone       String?
  incomeRange    String? // optional field — the one exception to "required"
  partnerAgeMin  Int?
  partnerAgeMax  Int?

  // Step 4 (Mlezi/Wali) — optional, toggle-gated
  hasGuardian          Boolean @default(false)
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?

  // Onboarding: Steps 1-3 (personal/address/intentions) are mandatory and
  // gate the rest of the site — see lib/onboarding.ts, which derives
  // "next incomplete step" live from these fields rather than storing a
  // separate complete flag that could drift out of sync.
  country    String? // ISO 3166-1 alpha-2, e.g. "TZ"
  region     String? // Tanzania region name, or free text for other countries
  intentions String[] @default([]) // native array (unlike Package.features'
  // JSON-string convention, which predates this project's Postgres migration)

  // Step 4 (photo) is optional. Stored as bytes directly in Postgres and
  // served via an authenticated route handler rather than written to local
  // disk, since Netlify's runtime is stateless.
  photoEnc       Bytes?
  photoMimeType  String?
  photoUpdatedAt DateTime?

  // Step 5's second, independent upload — same storage shape as the photo
  // above (also optional/skippable; no admin review tool exists yet to act
  // on it, so nothing currently gates on idDocumentUpdatedAt being set).
  idDocumentEnc       Bytes?
  idDocumentMimeType  String?
  idDocumentUpdatedAt DateTime?

  // Sensitive fields, encrypted at rest (see lib/crypto.ts). Never returned
  // by an API unless both the viewer's tier and showPhoneToTier allow it.
  phoneEnc    String?
  locationEnc String?
  // Minimum viewer tier allowed to see the fields above: FREE|BASIC|SILVER|GOLD|PREMIUM
  showContactToTier String @default("GOLD")

  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// tier: "FREE" | "BASIC" | "SILVER" | "GOLD" | "PREMIUM"
model Package {
  id           String   @id @default(cuid())
  tier         String   @unique
  name         String
  priceTzs     Int
  durationDays Int
  tagline      String
  features     String // JSON-encoded string[]

  orders        Order[]
  subscriptions Subscription[]
}

// status: "PENDING" | "PAID" | "FAILED" | "CANCELLED"
model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  amountTzs Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  transactions Transaction[]
}

// Multiple rows can exist per order (retries after a failed attempt), each
// tied to one gateway callback. gatewayTxnId is the true idempotency key.
model Transaction {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  gatewayTxnId String?   @unique
  gateway      String?
  phoneNumber  String?
  verifiedAt   DateTime?
  rawPayload   String?
  createdAt    DateTime  @default(now())
}

// status: "ACTIVE" | "EXPIRED" | "CANCELLED"
model Subscription {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  status     String   @default("ACTIVE")
  startDate  DateTime @default(now())
  expiryDate DateTime
  updatedAt  DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

// purpose: "REGISTER" | "LOGIN"
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String    @default("REGISTER")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  city      String
  rating    Int
  body      String
  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// category: one of SUPPORT_CATEGORIES (lib/support.ts) | status: "PENDING"
// (no admin reply/status workflow exists yet — see lib/support.ts)
model ContactMessage {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticketSeq          Int      @unique @default(autoincrement())
  name               String
  email              String
  phone              String?
  category           String?
  subject            String?
  body               String
  attachmentEnc      Bytes?
  attachmentMimeType String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
}

model Favorite {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("FavoritesGiven", fields: [userId], references: [id], onDelete: Cascade)
  favoritedUserId String
  favoritedUser   User     @relation("FavoritesReceived", fields: [favoritedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([userId, favoritedUserId])
  @@index([favoritedUserId])
}

// type: "PROFILE_LIKED" (plain String, matching this schema's existing
// status/tier/gender String-enum convention)
model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String   @default("PROFILE_LIKED")
  sourceUserId    String?
  source          User?    @relation("NotificationSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
}

model Block {
  id            String   @id @default(cuid())
  blockerId     String
  blocker       User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

// reason: one of REPORT_REASONS (lib/reports.ts) | status: "PENDING" (no
// reviewer/admin workflow exists yet to act on these — see lib/reports.ts)
model Report {
  id               String   @id @default(cuid())
  reporterId       String
  reporter         User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason           String
  description      String
  evidenceEnc      Bytes?
  evidenceMimeType String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([reportedUserId])
}
