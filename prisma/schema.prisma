// Nusrah data model.
// NOTE: tier/status/gender/etc. are plain Strings rather than native Postgres
// enums, validated with zod / lib/tiers.ts at the app layer instead — kept
// this way (originally built against SQLite, which has no enum support) for
// simplicity; revisit if stricter DB-level constraints are ever needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// role: "MEMBER" | "ADMIN" — an ADMIN row is a dedicated account created via
// scripts/promote-admin.ts, never a member's own upgraded account, so an
// admin session never intersects with the (app) layout's onboarding guard.
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  otpVerified  Boolean  @default(false)
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  termsAcceptedAt DateTime @default(now())

  profile          Profile?
  orders           Order[]
  subscription     Subscription?
  otpCodes         OtpCode[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  reviews          Review[]
  contactMessages  ContactMessage[]

  favoritesGiven         Favorite[]     @relation("FavoritesGiven")
  favoritesReceived      Favorite[]     @relation("FavoritesReceived")
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsSourced   Notification[] @relation("NotificationSource")

  blocksGiven      Block[]  @relation("BlocksGiven")
  blocksReceived   Block[]  @relation("BlocksReceived")
  reportsFiled     Report[] @relation("ReportsFiled")
  reportsReceived  Report[] @relation("ReportsReceived")

  callsInitiated Call[] @relation("CallsInitiated")
  callsReceived  Call[] @relation("CallsReceived")
}

// gender: "MALE" | "FEMALE"
model Profile {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender   String?
  dob      DateTime?
  city     String?
  bio      String?

  // Step 1 (Taarifa Binafsi) additions
  displayName   String?
  maritalStatus String? // AMEOA_AMEOLEWA | SIJAOA_SIJAOLEWA | TALAKA | MJANE | AMETENGANA

  // Step 2 (Maelezo ya Dini) — all new
  religion     String?
  madhhab      String?
  prayerHabit  String?
  wearsHijab   String? // only asked/shown when gender = FEMALE
  quranLevel   String?
  substanceUse String?

  // Step 3 (Maelezo ya Maisha) additions — intentions/bio already existed above
  occupation     String?
  educationLevel String?
  height         Int? // cm
  bodyType       String?
  skinTone       String?
  incomeRange    String? // optional field — the one exception to "required"
  hasDisability  Boolean? // optional, sensitive — never required to complete onboarding
  disabilityType String? // meaningful only when hasDisability is true
  partnerAgeMin  Int?
  partnerAgeMax  Int?

  // Step 4 (Mlezi/Wali) — optional, toggle-gated
  hasGuardian          Boolean @default(false)
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?

  // Onboarding: Steps 1-3 (personal/address/intentions) are mandatory and
  // gate the rest of the site — see lib/onboarding.ts, which derives
  // "next incomplete step" live from these fields rather than storing a
  // separate complete flag that could drift out of sync.
  country    String? // ISO 3166-1 alpha-2, e.g. "TZ"
  region     String? // Tanzania region name, or free text for other countries
  intentions String[] @default([]) // native array (unlike Package.features'
  // JSON-string convention, which predates this project's Postgres migration)

  // Step 4 (photo) is optional. Stored as bytes directly in Postgres and
  // served via an authenticated route handler rather than written to local
  // disk, since Netlify's runtime is stateless.
  photoEnc       Bytes?
  photoMimeType  String?
  photoUpdatedAt DateTime?

  // Up to 6 additional gallery photos beyond the cover photo above (7 total).
  // Not circle-cropped like the cover photo — full images, uploaded via
  // PhotoGallery.tsx from either onboarding Step 5 or Wasifu Wangu.
  photos ProfilePhoto[]

  // ID document verification was removed from the app (no more upload UI,
  // no more /api/onboarding/id-document route, no more hasIdDocument()) —
  // these 3 columns are kept only because the currently-deployed production
  // app still queries Profile without an explicit select and would break if
  // they were dropped before that deployment is replaced. Drop them in the
  // same migration that finally deploys this removal, not before.
  idDocumentEnc       Bytes?
  idDocumentMimeType  String?
  idDocumentUpdatedAt DateTime?

  // Sensitive fields, encrypted at rest (see lib/crypto.ts). Never returned
  // by an API unless both the viewer's tier and showPhoneToTier allow it.
  phoneEnc    String?
  locationEnc String?
  // Minimum viewer tier allowed to see the fields above: FREE|BASIC|SILVER|GOLD|PREMIUM
  showContactToTier String @default("GOLD")

  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy — superseded by verificationStatus below (now the real source of
  // truth, with an in-app admin review workflow). Kept only as a historical
  // backfill source; never read or written past the migration that added
  // verificationStatus. Safe to drop in a later cleanup once that new flow
  // has been used for real.
  isVerified Boolean @default(false)
  // "NOT_STARTED" | "PENDING" | "VERIFIED" | "REJECTED" — reviewed via the
  // admin dashboard (app/admin/(dashboard)/verification).
  verificationStatus String @default("NOT_STARTED")
  // Written opportunistically (throttled) from (app)/layout.tsx on every
  // authenticated page load — see lib/profiles.ts's touchLastActive. Never
  // exposed directly; only the derived boolean isOnline (SerializedProfile)
  // ever leaves lib/profiles.ts, per the "no last-active timeline" decision.
  lastActiveAt DateTime?
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  imageEnc  Bytes
  mimeType  String
  position  Int // 1-6; position 0 is implicitly Profile.photoEnc (the cover photo)
  createdAt DateTime @default(now())

  @@unique([profileId, position])
  @@index([profileId])
}

// tier: "FREE" | "BASIC" | "SILVER" | "GOLD" | "PREMIUM"
model Package {
  id           String   @id @default(cuid())
  tier         String   @unique
  name         String
  priceTzs     Int
  durationDays Int
  tagline      String
  features     String // JSON-encoded string[]

  orders        Order[]
  subscriptions Subscription[]
}

// status: "PENDING" | "PAID" | "FAILED" | "CANCELLED"
model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  amountTzs Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  transactions Transaction[]
}

// Multiple rows can exist per order (retries after a failed attempt), each
// tied to one gateway callback. gatewayTxnId is the true idempotency key.
model Transaction {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  gatewayTxnId String?   @unique
  gateway      String?
  phoneNumber  String?
  verifiedAt   DateTime?
  rawPayload   String?
  createdAt    DateTime  @default(now())
}

// status: "ACTIVE" | "EXPIRED" | "CANCELLED"
model Subscription {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  status     String   @default("ACTIVE")
  startDate  DateTime @default(now())
  expiryDate DateTime
  updatedAt  DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

// type: "VOICE" | "VIDEO" | status: "RINGING" | "ACCEPTED" | "DECLINED" | "ENDED" | "MISSED"
// channelName is the Agora channel both parties join once ACCEPTED — unique
// per call so a stale/reused token can never bleed into a different call.
model Call {
  id          String    @id @default(cuid())
  callerId    String
  caller      User      @relation("CallsInitiated", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId    String
  callee      User      @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  type        String
  channelName String    @unique
  status      String    @default("RINGING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  endedAt     DateTime?

  @@index([calleeId, status])
  @@index([callerId, status])
}

// purpose: "REGISTER" | "LOGIN"
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String    @default("REGISTER")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  city      String
  rating    Int
  body      String
  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// category: one of SUPPORT_CATEGORIES (lib/support.ts) | status: "PENDING"
// (no admin reply/status workflow exists yet — see lib/support.ts)
model ContactMessage {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticketSeq          Int      @unique @default(autoincrement())
  name               String
  email              String
  phone              String?
  category           String?
  subject            String?
  body               String
  attachmentEnc      Bytes?
  attachmentMimeType String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
}

model Favorite {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("FavoritesGiven", fields: [userId], references: [id], onDelete: Cascade)
  favoritedUserId String
  favoritedUser   User     @relation("FavoritesReceived", fields: [favoritedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([userId, favoritedUserId])
  @@index([favoritedUserId])
}

// type: "PROFILE_LIKED" | "MESSAGE_RECEIVED" | "MISSED_VOICE_CALL" |
// "MISSED_VIDEO_CALL" (plain String, matching this schema's existing
// status/tier/gender String-enum convention)
model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String   @default("PROFILE_LIKED")
  sourceUserId    String?
  source          User?    @relation("NotificationSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
}

model Block {
  id            String   @id @default(cuid())
  blockerId     String
  blocker       User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

// type: "NEW_REPORT" | "NEW_REGISTRATION" — surfaced in the admin top bar
// bell (components/admin/AdminNotificationBell.tsx). Deliberately its own
// small table, not a reuse of Notification, which is member-facing (has a
// required recipientUserId, hardcoded per-type Swahili text) and answers a
// different question ("what happened to me") than this one ("what needs
// admin attention"). No stuck-payment alert type here on purpose — that's
// discovered by elapsed time, not a state change to hook; Phase 4's
// /admin/payments/pending queue is already that surface.
model AdminAlert {
  id        String   @id @default(cuid())
  type      String
  message   String
  linkHref  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// reason: one of REPORT_REASONS (lib/reports.ts) | status: "PENDING" (no
// reviewer/admin workflow exists yet to act on these — see lib/reports.ts)
model Report {
  id               String   @id @default(cuid())
  reporterId       String
  reporter         User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason           String
  description      String
  evidenceEnc      Bytes?
  evidenceMimeType String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([reportedUserId])
}
